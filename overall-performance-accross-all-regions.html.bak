<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Starter Page - FlexStart Bootstrap Template</title>
  <meta name="description" content="">
  <meta name="keywords" content="">

  <!-- Favicons -->
  <link href="assets/img/logo.svg" rel="icon">
  <link href="assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Nunito:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
  <!-- Vendor CSS Files -->
  <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
  <link href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/main.css" rel="stylesheet">

  <link rel="stylesheet" href="assets/css/style_scoreboard/scoreboard.css">

  <!-- script for the scoreboard main part -->
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <script defer src="assets/js/utils_scoreboard/data_process.js"></script>
  <script defer src="assets/js/utils_scoreboard/draw_chart.js"></script>

</head>

<body class="overall-performance-accross-all-regions">

  <header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">

      <a href="index.html" class="logo d-flex align-items-center me-auto">
        <!-- Uncomment the line below if you also wish to use an image logo -->
        <img src="assets/img/logo.svg" alt="">
        <h1 class="sitename">Cortex</h1>
      </a>

      <div class="header-title mx-auto">
        <h1>Overall performance across all regions</h1>
      </div>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="index.html">Home<br></a></li>
          <li><a href="lab-page.html">The Lab</a></li>
          <li><a href="scoreboard-page.html" class="active">The Scoreboard</a></li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

    </div>
  </header>

  <main class="main">


    <main class="main container mt-4">

      <!-- Buttons for region selection -->


      <button onclick="window.location.href='scoreboard-page.html'">Back to Start</button>



      <div class="button-container">
        <div class="label-container"><b>Training Dataset:</b></div>
        <button id="btn-training-Murty185" onclick = "updateTraining('Murty185')">Murty185</button>
        <button id="btn-training-NSD" onclick = "updateTraining('NSD')">NSD</button>
      </div>

      <div class="button-container">
        <div class="label-container"><b>Evaluation Dataset:</b></div>
        <button id="btn-NSD"  onclick="updateDataset('NSD')">NSD</button>
        <button id="btn-Murty185"  onclick="updateDataset('Murty185')">Murty185</button>
        <button id="btn-BOLD5000" onclick="updateDataset('BOLD5000')">BOLD5000</button>
        <button id="btn-BonnerEpstein" onclick="updateDataset('BonnerEpstein')">BonnerEpstein</button>
        <button id="btn-KingBaker" onclick="updateDataset('KingBaker')">KingBaker</button>
        <button id="btn-algonauts" onclick="updateDataset('algonauts')">algonauts</button>
      </div>

      <div class="button-container">
        <div class="label-container"><b>ROI:</b></div>
        <button id="btn-Overall" onclick="updateChart('Overall')">Cross-Regions</button>
        <button id="btn-PPA"  onclick="updateROI('PPA')">PPA</button>
        <button id="btn-FFA" onclick="updateROI('FFA')">FFA</button>
        <button id="btn-EBA" onclick="updateROI('EBA')">EBA</button>
      </div>

      <!-- Chart container -->
      <div class="overallchart">
        <div id="loading-overlay">
          <p>Loading...</p>
        </div>
        <div id="overall"></div>
      </div>

      <div id="snapshot">
        <div class="thumbnail-container">

            <div class="thumbnail" onclick="window.location.href='cross-region-performance-page.html'">
                <div class="iframe-container">
                    <iframe id="previewFrame" src="cross-region-performance-page.html"></iframe>
                </div>
                <p>Model Performance Cross Regions</p>
            </div>


            <div class="thumbnail" onclick="window.location.href='roi-performance-page.html'">
                <div class="iframe-container">
                    <iframe id="previewFrame" src="roi-performance-page.html"></iframe>
                </div>
                <p>Model Performance on ROI</p>
            </div>
            <div class="thumbnail">
                <img src="thumbnail_placeholder.png" alt="Placeholder">
                <p>More Models</p>
            </div>
            <div class="thumbnail">
                <img src="thumbnail_placeholder.png" alt="Placeholder">
                <p>More Models</p>
            </div>
        </div>
    </div>


      <script>

        let width = window.innerWidth * 0.9;
        let height = window.innerHeight * 0.7;
        const margin = { top: 30 , right: 150, bottom: 100, left: 300 };
        let selectedTraining = "Murty185";
        let selectedDataset = "";
        let selectedROI = "Overall"

        window.addEventListener("load", function() {
          console.log("✅ window.onload triggered!");

          function resizeChart() {
                width = window.innerWidth * 0.9;
                height = window.innerHeight * 0.8;

                d3.select("#overall").select("svg").remove();
                drawChartOverall("#overall", window.overallData, "Cross-Regions");

            }

          window.addEventListener("resize", resizeChart);
          document.getElementById("loading-overlay").style.display = "flex";
          loadData((data) => {
              window.allTrainingData = data;
              const trainingData = data[selectedTraining];
              console.log("✅ Data Loaded inside onload:", trainingData.overallData, trainingData.ppaData, trainingData.ffaData, trainingData.ebaData);

              if (!trainingData.overallData || trainingData.overallData.length === 0) {
                  console.error("❌ overallData is empty!");
                  return;
              }

              window.overallData = trainingData.overallData;
              window.ppaData = trainingData.ppaData;
              window.ffaData = trainingData.ffaData;
              window.ebaData = trainingData.ebaData;

              drawChartOverall("#overall", trainingData.overallData, "Cross-Regions");
              d3.select(`#btn-training-${selectedTraining}`).classed("selected-button", true);
              d3.select(`#btn-${selectedROI}`).classed("selected-button", true);
              document.getElementById("loading-overlay").style.display = "none";
              updateTraining(selectedTraining);

          });

      });

        function updateTraining(training) {
            selectedTraining = training;
            localStorage.setItem("selectedTraining", selectedTraining);
            localStorage.setItem("selectedDataset", selectedDataset);
            localStorage.setItem("selectedROI", selectedROI);
            const evalNSD = document.getElementById("btn-NSD");
            const evalMurty = document.getElementById("btn-Murty185");
            d3.selectAll("button").classed("selected-button", false);
            d3.select(`#btn-training-${training}`).classed("selected-button", true);
            d3.select(`#btn-${selectedROI}`).classed("selected-button", true);


            if (training === "Murty185") {
                evalMurty.style.display = "none";
                evalNSD.style.display = "inline-block";
            } else if (training === "NSD") {
                evalNSD.style.display = "none";
                evalMurty.style.display = "inline-block";
            }

            const trainingData = window.allTrainingData[selectedTraining];
            window.overallData = trainingData.overallData;
            d3.select("#overall").select("svg").remove(); // ✅ 清除旧图
            drawChartOverall("#overall", trainingData.overallData, "Cross-Regions");

        }

        function updateDataset(dataset) {
          selectedDataset = dataset;
          localStorage.setItem("selectedTraining", selectedTraining);
          localStorage.setItem("selectedDataset", selectedDataset);
          localStorage.setItem("selectedROI", selectedROI);
          window.location.href = `cross-region-performance-page.html?training=${selectedTraining}&dataset=${selectedDataset}&roi=${selectedROI}`;

        }

        function updateROI(roi){
          window.location.href = `specify-roi-page.html?training=${selectedTraining}&dataset=""&roi=${selectedROI}`;



        }
    </script>




  </main>






</body>

  <footer id="footer" class="footer">

    <div class="container copyright text-center mt-4">
      <p>© <span>Copyright</span> <strong class="px-1 sitename"><a href="https://www.murtylab.com" target="_blank" rel="noopener noreferrer">Murty Lab @ Georgia Tech</a></strong> <span>All Rights Reserved</span></p>
      <div class="credits">
      </div>
    </div>

  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Vendor JS Files -->
  <script src="assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="assets/vendor/php-email-form/validate.js"></script>
  <script src="assets/vendor/aos/aos.js"></script>
  <script src="assets/vendor/glightbox/js/glightbox.min.js"></script>
  <script src="assets/vendor/purecounter/purecounter_vanilla.js"></script>
  <script src="assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
  <script src="assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
  <script src="assets/vendor/swiper/swiper-bundle.min.js"></script>

  <!-- Main JS File -->
  <script src="assets/js/main.js"></script>

</body>

</html>