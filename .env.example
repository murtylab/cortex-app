VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Use /cortex-core with `npm run dev` when the browser reaches this machine
# through VS Code Remote SSH or another single-port tunnel.
VITE_CORTEX_CORE_URL=/cortex-core
# Optional public inference endpoint alias; VITE_CORTEX_CORE_URL takes precedence.
VITE_SERVER_URL=
CORTEX_CORE_PROXY_TARGET=http://127.0.0.1:5556
VITE_CORTEX_INFOVIZ_URL=/infoviz
INFOVIZ_PROXY_TARGET=http://127.0.0.1:5174
# Optional: the whole-brain service is separate from Cortex Core.
VITE_CORTEX_WHOLE_BRAIN_URL=http://localhost:5557
