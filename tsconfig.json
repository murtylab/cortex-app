{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "jsx": "react-jsx",
      "allowJs": true,
      "checkJs": false,
      "strict": true,
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "outDir": "./dist",
      "allowImportingTsExtensions": true,
      "noEmit": true,
      "types": ["vite/client"]
    },
    "include": ["assets", "assets/js/Lab/barchart.jsx", "assets/js/barchartspecific.jsx", "assets/js/Lab/barchartstyles.jsx", "assets/js/components.jsx", "assets/js/constants-scoreboard.jsx", "assets/js/constants.jsx", "assets/js/Scoreboard/Settings/datasetselect.jsx", "assets/js/heatmap.jsx", "assets/js/Lab/heatmapstyles.jsx"],
    "exclude": ["node_modules", "dist"]
}
  